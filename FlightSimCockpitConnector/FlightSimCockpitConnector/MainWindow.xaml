<Window x:Class="MSFSSimConnectWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cockpit Connector Calibration"
        Height="600"
        Width="600">

    <StackPanel VerticalAlignment="Stretch">
        <Grid VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Margin="5">
                <TextBlock Text="Airspeed" FontWeight="Bold" FontStyle="Italic" />
                <TextBlock Text="Current State:"/>
                <TextBlock Name="SpeedText"/>

                <TextBlock Text="Calibration" FontWeight="Bold" FontStyle="Italic" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" >
                    <TextBlock Text="At 0kt" />
                    <Separator Width="4" Visibility="Hidden"/>
                    <TextBox x:Name="calibASZero"
                        Width="100" HorizontalAlignment="Left"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" >
                    <TextBlock Text="At 100kt" />
                    <Separator Width="4" Visibility="Hidden"/>
                    <TextBox x:Name="calibAS100"
                     Width="100" HorizontalAlignment="Left"/>
                </StackPanel>

            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="1" Margin="5" >
                <TextBlock Text="Atitude Indicator" FontWeight="Bold" FontStyle="Italic"  />
                <TextBlock Text="Current Pitch State:" />
                <TextBlock Name="PitchText"/>
                <TextBlock Text="Current Bank State:" />
                <TextBlock Name="BankText"/>

                <TextBlock Text="Calibration Pitch" FontWeight="Bold" FontStyle="Italic" />

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" >
                    <TextBlock Text="-20°"/>
                    <Separator Width="4" Visibility="Hidden"/>
                    <TextBox x:Name="calibPitchNeg20"
                         Width="100" HorizontalAlignment="Left"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" >
                    <TextBlock Text="0°"/>
                    <Separator Width="4" Visibility="Hidden"/>
                    <TextBox x:Name="calibPitchZero"
                         Width="100" HorizontalAlignment="Left"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" >
                    <TextBlock Text="+20°"/>
                    <Separator Width="4" Visibility="Hidden"/>
                    <TextBox x:Name="calibPitchPos20"
                         Width="100" HorizontalAlignment="Left"/>
                </StackPanel>

                    <TextBlock Text="Calibration Roll" FontWeight="Bold" FontStyle="Italic" />
                

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" >
                    <TextBlock Text="-20°"/>
                    <Separator Width="4" Visibility="Hidden"/>
                    <TextBox x:Name="calibRollNeg20"     
                         Width="100" HorizontalAlignment="Left"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" >
                    <TextBlock Text="0°"/>
                    <Separator Width="4" Visibility="Hidden"/>
                    <TextBox x:Name="calibRollZero"     
                         Width="100" HorizontalAlignment="Left"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" >
                    <TextBlock Text="+20°"/>
                    <Separator Width="4" Visibility="Hidden"/>
                    <TextBox x:Name="calibRollPos20"
                         Width="100" HorizontalAlignment="Left"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="2" Margin="5">
                <TextBlock Text="Altitude Indicator" FontWeight="Bold" FontStyle="Italic" />
                <TextBlock Text="Current State:"/>
                <TextBlock Name="AltitudeText"/>

                <TextBlock Text="Calibration 100 ft needle"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button>-5 Steps</Button>
                    <Separator Width="4" Visibility="Hidden"/>
                    <Button>+5 Steps</Button>
                </StackPanel>

                <TextBlock Text="Calibration 1000 ft needle"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button>-5 Steps</Button>
                    <Separator Width="4" Visibility="Hidden"/>
                    <Button>+5 Steps</Button>
                </StackPanel>

                <TextBlock Text="Calibration 10000 ft needle"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button>-5 Steps</Button>
                    <Separator Width="4" Visibility="Hidden"/>
                    <Button>+5 Steps</Button>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0" Margin="5">
                <TextBlock Text="Turn/Slip Indicator" FontWeight="Bold" FontStyle="Italic" />
                <TextBlock Text="Current State Turn:" />
                <TextBlock Name="TurnText"/>

                <TextBlock Text="Current State Slip:" />
                <TextBlock Name="SlipText"/>

                <TextBlock Text="Calibration Turn" FontWeight="Bold" FontStyle="Italic" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" >
                    <TextBlock Text="1 Rot. Left"/>
                    <Separator Width="4" Visibility="Hidden"/>
                    <TextBox x:Name="calibTurnLeft"
                         Width="100" HorizontalAlignment="Left"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" >
                    <TextBlock Text="Center"/>
                    <Separator Width="4" Visibility="Hidden"/>
                    <TextBox x:Name="calibTurnCenter"
                         Width="100" HorizontalAlignment="Left"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" >
                    <TextBlock Text="1 Rot. Right"/>
                    <Separator Width="4" Visibility="Hidden"/>
                    <TextBox x:Name="CalibTurnRight"
                        
                         Width="100" HorizontalAlignment="Left"/>
                </StackPanel>


                <TextBlock Text="Calibration Slip" FontWeight="Bold" FontStyle="Italic" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" >
                    <TextBlock Text="Slip Left:"/>
                    <Separator Width="4" Visibility="Hidden"/>
                    <TextBox x:Name="calibSlipLeft"
                         Width="100" HorizontalAlignment="Left"/>
                </StackPanel>
                <!--Header="At " PlaceholderText="0"-->
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" >
                    <TextBlock Text="Slip Center:"/>
                    <Separator Width="4" Visibility="Hidden"/>
                    <TextBox x:Name="calibSlipCenter"
                         Width="100" HorizontalAlignment="Left"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" >
                    <TextBlock Text="Slip Right:"/>
                    <Separator Width="4" Visibility="Hidden"/>
                    <TextBox x:Name="calibSlipRight"
                         Width="100" HorizontalAlignment="Left"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="1" Margin="5">
                <TextBlock Text="Heading Indicator" FontWeight="Bold" FontStyle="Italic" />
                <TextBlock Text="Current State:" />
                <TextBlock Name="HeadingText"/>

                <TextBlock Text="Calibration" FontWeight="Bold" FontStyle="Italic"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button>-5 Steps</Button>
                    <Separator Width="4" Visibility="Hidden"/>
                    <Button>+5 Steps</Button>
                </StackPanel>

            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="2" Margin="5">
                <TextBlock Text="Vertical Speed Indicator" FontWeight="Bold" FontStyle="Italic" />
                <TextBlock Text="Current State:" />
                <TextBlock Name="VerticalSpeedText"/>

                <TextBlock Text="Calibration" FontWeight="Bold" FontStyle="Italic" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" >
                    <TextBlock Text="At -5 ft/s:" />
                    <Separator Width="4" Visibility="Hidden"/>
                    <TextBox x:Name="calibVSMinus5"
                         Width="100" HorizontalAlignment="Left"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" >
                    <TextBlock Text="At 0 ft/s:" />
                    <Separator Width="4" Visibility="Hidden"/>
                    <TextBox x:Name="calibVSZero"
                         Width="100" HorizontalAlignment="Left"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" >
                    <TextBlock Text="At +5 ft/s:"></TextBlock>
                    <Separator Width="4" Visibility="Hidden"/>
                    <TextBox x:Name="calibVSPlus5"
                         Width="100" HorizontalAlignment="Left"/>
                </StackPanel>
            </StackPanel>
        </Grid>
        <StackPanel Orientation="Horizontal" Height="30" HorizontalAlignment="Right">
            <Button Click="RefreshSerialPortList">Refresh</Button>
            <ComboBox Name="SerialPortSelector" SelectionChanged="SerialPortSelector_SelectionChanged">
                <ComboBoxItem>COM1</ComboBoxItem>
            </ComboBox>
            <Button Click="SerialPortSelected">Select Port</Button>
            <Separator Width="40" Visibility="Hidden"/>
            <Button Name="QuitApp" Click="AppQuit">Quit</Button>
        </StackPanel>
    </StackPanel>



</Window>
